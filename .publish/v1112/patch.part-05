diff --git a/dashboard.css b/dashboard.css
index 3ffd837..09074ac 100644
--- a/dashboard.css
+++ b/dashboard.css
@@ -286,6 +286,18 @@ h2 { margin: 4px 0 0; font-size: 20px; }
 .agent-card.agent-a { border-left-color: var(--a); }
 .agent-card.agent-b { border-left-color: var(--b); }
 .agent-card.agent-c { border-left-color: var(--c); }
+
+.agent-identity { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.round-timer {
+  display: inline-flex; align-items: center; min-width: 74px; justify-content: center;
+  border: 1px solid var(--line-strong); border-radius: 999px; padding: 3px 7px;
+  font-variant-numeric: tabular-nums; font-size: 10px; font-weight: 800; letter-spacing: .01em;
+  color: var(--muted); background: var(--ghost-bg); white-space: nowrap;
+}
+.round-timer.active { color: var(--text); border-color: var(--c); box-shadow: 0 0 0 2px var(--shadow-focus); animation: timerPulse 1.4s ease-in-out infinite; }
+@keyframes timerPulse { 0%, 100% { opacity: .78; } 50% { opacity: 1; } }
+@media (prefers-reduced-motion: reduce) { .round-timer.active { animation: none; } }
+
 .agent-topline { display: flex; align-items: center; justify-content: space-between; margin-bottom: 7px; font-size: 12px; }
 .agent-card textarea { min-height: 64px; margin-top: 7px; }
 .work-mode-card { border: 1px solid var(--line); border-radius: 10px; background: var(--panel-3); padding: 9px; margin-bottom: 10px; }
