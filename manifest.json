{
  "manifest_version": 3,
  "name": "AI Bridge",
  "version": "1.15.0",
  "description": "Coordinate three AI agents with relay, direct-mesh routing, team-cycle timing, stuck recovery, a Settings tab, GitHub update checks, optional Chrome Sync and Google Drive appDataFolder settings, persistent artifact vault storage, ZIP/file relay, human control, system-awake protection during active runs, and a modern multi-theme workspace.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "downloads",
    "notifications",
    "scripting",
    "identity",
    "alarms",
    "power"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://grok.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://*.oaiusercontent.com/*",
    "https://assets.grok.com/*",
    "https://*.x.ai/*",
    "https://*.googleusercontent.com/*",
    "https://*.anthropic.com/*",
    "https://*.microsoft.com/*",
    "https://x.ai/*",
    "https://api.x.ai/*",
    "https://www.googleapis.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://codeload.github.com/*"
  ],
  "background": {
    "service_worker": "background-wrapper.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Bridge",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
