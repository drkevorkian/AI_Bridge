{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "AI Bridge",
  "version": "1.18.0",
  "description": "Coordinate 1–5 logical AI agents across selected AI tabs, including multiple independent tabs from the same provider, with themes, Settings, recovery, manual relay, cloud sync, updates, and workspace layouts.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "downloads",
    "notifications",
    "scripting",
    "identity",
    "alarms",
    "power"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://grok.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://*.oaiusercontent.com/*",
    "https://assets.grok.com/*",
    "https://assets.grokusercontent.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.anthropic.com/*",
    "https://www.googleapis.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://codeload.github.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "background": {
    "service_worker": "background-wrapper.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Bridge",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "content-runtime-prelude.js",
        "content-artifact-security-prelude.js",
        "content-completion-guard.js",
        "content-response-delivery-hardening.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
